# Copy to .env and fill in. Never commit your real .env.
# NOTE: No API key is required. With OCR_PROVIDER=auto and no key set, the app
# uses the local EasyOCR/Tesseract engine automatically.

# auto | gemini | openai | google_vision | local
OCR_PROVIDER=auto

# --- Gemini (STRONGLY RECOMMENDED — used automatically once a key is present) ---
# The local EasyOCR/Tesseract ensemble cannot read handwriting. Measured on the
# labelled set, a vision model takes F1 from 0.250 to 0.783 and character error
# from 0.376 to 0.000, while running FASTER (2.1s vs 3.3s per image).
# Free key: https://aistudio.google.com  ->  "Get API key"
# GEMINI_API_KEY=your_google_ai_studio_key_here
# Pick a model your project actually has quota for — new projects get a
# free-tier limit of 0 on the gemini-2.x models, which silently degrades to
# local OCR. gemini-3.1-flash-lite and gemini-3-flash-preview work on free tier.
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional: OpenAI GPT-4o ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Optional: Google Cloud Vision ---
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# --- Tuning ---
MEDICINE_MATCH_THRESHOLD=72
OCR_MIN_CONFIDENCE=0.6
ENABLE_PREPROCESSING=true
